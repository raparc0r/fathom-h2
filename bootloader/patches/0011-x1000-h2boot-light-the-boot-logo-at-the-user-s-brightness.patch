From: Fathom <fathom@localhost>
Subject: [PATCH] x1000: h2boot: light the boot logo at the user's brightness

backlight_init() lit the logo at full, and it stayed so until the player
set the user's level, seconds later. The level is now read from
/fathom/settings.ini (display.brightness; 3 without one) before the logo
lights up, and set right after (bootlight.c, from bootloader/fathom), at the
period Linux uses (20 us): the kernel keeps it (its patch 0026), so the
logo stays at the user's level from power-on to the player.
---
--- a/bootloader/SOURCES	2026-11-21 15:41:02
+++ b/bootloader/SOURCES	2026-11-21 15:41:18
@@ -84,6 +84,7 @@
 x1000/fwcopy.c
 x1000/fwcopy-h2boot.c
 x1000/bootpick.c
+x1000/bootlight.c
 #endif
 #elif defined(HIBY_R1_NATIVE)
 ingenic/gui-ingenic.c
--- a/bootloader/x1000/boot.c	2026-11-21 15:41:02
+++ b/bootloader/x1000/boot.c	2026-11-21 15:41:18
@@ -29,6 +29,7 @@
 #include "boot-x1000.h"
 #if defined(EROS_QN)
 #include "bootpick.h"
+#include "bootlight.h"
 #endif
 #include <ctype.h>
 #include <sys/types.h>
@@ -138,10 +139,15 @@
     fathom_copy_firmware(false);
     /* Fathom: which stock firmware is in the flash, for Uninstall Fathom */
     fathom_note_stock_version();
+    /* Fathom: the logo at the user's brightness, read before it lights up
+     * (bootlight.c): backlight_init() lights it at full, set at once to it */
+    int has_card = check_disk(false) == DISK_PRESENT;
+    int light = fathom_boot_light_level(has_card);
     show_boot_logo();   /* Fathom: on screen while the kernel loads */
+    fathom_boot_light(light);
     /* Fathom: an update's kernel gets two starts to reach the player, then
      * the one before it goes back in place (bootpick.c) */
-    int fell_back = check_disk(false) == DISK_PRESENT && fathom_boot_pick();
+    int fell_back = has_card && fathom_boot_pick();
 #endif
     struct uimage_header uh;
     size_t img_length;
