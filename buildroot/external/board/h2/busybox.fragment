# Fathom: DHCP server for the USB network link to the computer
CONFIG_UDHCPD=y
# Fathom: the clock from the network when Wi-Fi connects (udhcpc hook fathom-ntp)
CONFIG_NTPD=y
CONFIG_TIMEOUT=y
# Fathom: root's password for SSH and the serial console (fathom-ssh)
CONFIG_CHPASSWD=y
CONFIG_FEATURE_DEFAULT_PASSWD_ALGO="sha512"
# Repeated lines are dropped from the RAM log (syslogd -D, /etc/default/syslogd)
CONFIG_FEATURE_SYSLOGD_DUP=y

# busybox lives in the initramfs, so all of it is RAM all the time. Left out:
# what the H2 has no use for. Kept: everything Fathom's scripts, Buildroot's
# init scripts and the player call, and what diagnosing over SSH or the serial
# console wants (ps, top, free, vi, less, dmesg, i2c tools, devmem, wget,
# ping, netstat, lsof, hexdump, strings, ...).
# usage texts: short ones only
# CONFIG_FEATURE_VERBOSE_USAGE is not set
# CONFIG_FEATURE_INSTALLER is not set
# no IPv6 in the kernel
# CONFIG_FEATURE_IPV6 is not set
# CONFIG_FEATURE_IFUPDOWN_IPV6 is not set
# CONFIG_FEATURE_HWIB is not set
