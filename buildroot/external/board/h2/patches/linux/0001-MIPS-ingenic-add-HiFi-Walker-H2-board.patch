From: Fathom <fathom@localhost>
Subject: [PATCH] MIPS: ingenic: add HiFi Walker H2 board

Board option and device tree for the HiFi Walker H2 (AIGO Eros Q hw4):
memory, timers (TCU channel 0 handed to PWM for the backlight), blue LED,
microSD, USB OTG (device, and host for USB DACs), buttons and scroll wheel, the hardware
RNG, display + backlight, a read-only PMIC battery monitor, and audio
(X1000 I2S -> ES9018K2M -> headphone amplifier -> output switch).

Signed-off-by: Fathom
---
diff -Naur a/arch/mips/boot/dts/ingenic/Makefile b/arch/mips/boot/dts/ingenic/Makefile
--- a/arch/mips/boot/dts/ingenic/Makefile
+++ b/arch/mips/boot/dts/ingenic/Makefile
@@ -4,4 +4,5 @@
 dtb-$(CONFIG_JZ4770_GCW0)	+= gcw0.dtb
 dtb-$(CONFIG_JZ4780_CI20)	+= ci20.dtb
 dtb-$(CONFIG_X1000_CU1000_NEO)	+= cu1000-neo.dtb
+dtb-$(CONFIG_X1000_HIFIWALKER_H2)	+= hifiwalker-h2.dtb
 dtb-$(CONFIG_X1830_CU1830_NEO)	+= cu1830-neo.dtb
diff -Naur a/arch/mips/boot/dts/ingenic/hifiwalker-h2.dts b/arch/mips/boot/dts/ingenic/hifiwalker-h2.dts
--- /dev/null
+++ b/arch/mips/boot/dts/ingenic/hifiwalker-h2.dts
@@ -0,0 +1,446 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * HiFi Walker H2 digital audio player (AIGO Eros Q family, hardware rev 4):
+ * Ingenic X1000, 32 MiB RAM, AXP2101 PMIC, ES9018K2M DAC.
+ *
+ * Nothing here writes the PMIC or the SPI-NAND flash; USB supplies VBUS only
+ * as the host, to a USB DAC (usb_vbus, while fathom-usbrole allows it).
+ * Pin assignments: from Rockbox's erosqnative port.
+ */
+/dts-v1/;
+
+#include "x1000.dtsi"
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/input/input.h>
+#include <dt-bindings/clock/ingenic,sysost.h>
+#include <dt-bindings/clock/ingenic,x1000-cgu.h>
+
+/ {
+	compatible = "hifiwalker,h2", "ingenic,x1000";
+	model = "HiFi Walker H2";
+
+	memory {
+		device_type = "memory";
+		reg = <0x0 0x02000000>;
+	};
+
+	/* Kernel log and oops records that survive a reset (pstore): 96 KiB, 1 MiB
+	 * below the top of RAM. Not the very top: booting from flash, the SPL takes
+	 * its buffers from there (and clears them); the bootloader works upwards
+	 * from the bottom (itself, the kernel image, the unpacked kernel). Two oops
+	 * records and the console's log, 32 KiB each; no pmsg zone (nothing writes
+	 * /dev/pmsg0). It was 128 KiB, 32 KiB of it never used: the pmsg zone and
+	 * 16 KiB too few for a third record. */
+	reserved-memory {
+		#address-cells = <1>;
+		#size-cells = <1>;
+		ranges;
+
+		ramoops@1f00000 {
+			compatible = "ramoops";
+			reg = <0x01f00000 0x18000>;
+			record-size = <0x8000>;
+			console-size = <0x8000>;
+		};
+	};
+
+	leds {
+		compatible = "gpio-leds";
+
+		led-0 {
+			label = "blue";
+			gpios = <&gpb 7 GPIO_ACTIVE_HIGH>;
+			linux,default-trigger = "heartbeat";
+		};
+	};
+
+	/* Buttons: plain GPIOs, active low (Rockbox button-erosqnative.c, hw4 pins) */
+	keys {
+		compatible = "gpio-keys";
+
+		key-power {
+			label = "Power";
+			gpios = <&gpb 31 GPIO_ACTIVE_LOW>;
+			linux,code = <KEY_POWER>;
+			debounce-interval = <10>;
+			wakeup-source;
+		};
+		key-menu {
+			label = "Menu";
+			gpios = <&gpb 28 GPIO_ACTIVE_LOW>;
+			linux,code = <KEY_MENU>;
+			debounce-interval = <10>;
+		};
+		key-back {
+			label = "Back";
+			gpios = <&gpa 18 GPIO_ACTIVE_LOW>;
+			linux,code = <KEY_BACK>;
+			debounce-interval = <10>;
+		};
+		key-play {
+			label = "Play";
+			gpios = <&gpa 16 GPIO_ACTIVE_LOW>;
+			linux,code = <KEY_PLAYPAUSE>;
+			debounce-interval = <10>;
+		};
+		key-prev {
+			label = "Previous";
+			gpios = <&gpd 4 GPIO_ACTIVE_LOW>;
+			linux,code = <KEY_PREVIOUSSONG>;
+			debounce-interval = <10>;
+		};
+		key-next {
+			label = "Next";
+			gpios = <&gpc 24 GPIO_ACTIVE_LOW>;
+			linux,code = <KEY_NEXTSONG>;
+			debounce-interval = <10>;
+		};
+		key-volume-up {
+			label = "Volume up";
+			gpios = <&gpa 17 GPIO_ACTIVE_LOW>;
+			linux,code = <KEY_VOLUMEUP>;
+			debounce-interval = <10>;
+		};
+		key-volume-down {
+			label = "Volume down";
+			gpios = <&gpa 19 GPIO_ACTIVE_LOW>;
+			linux,code = <KEY_VOLUMEDOWN>;
+			debounce-interval = <10>;
+		};
+		switch-headphone {
+			label = "Headphones";
+			gpios = <&gpb 14 GPIO_ACTIVE_LOW>;
+			linux,input-type = <EV_SW>;
+			linux,code = <SW_HEADPHONE_INSERT>;
+			debounce-interval = <50>;
+		};
+		switch-lineout {
+			label = "Line out";
+			gpios = <&gpb 22 GPIO_ACTIVE_LOW>;
+			linux,input-type = <EV_SW>;
+			linux,code = <SW_LINEOUT_INSERT>;
+			debounce-interval = <50>;
+		};
+	};
+
+	/* Scroll wheel: quadrature on PB24 (A) / PB23 (B), one detent = two state changes.
+	 * The detents rest where A != B, which the half-period decoder takes for the
+	 * in-between states (it would count each click halfway and miss the first
+	 * after a change of direction): B inverted and listed first moves the states
+	 * a quarter turn, so the detents are its stable ones; same direction. */
+	wheel {
+		compatible = "rotary-encoder";
+		gpios = <&gpb 23 GPIO_ACTIVE_LOW>, <&gpb 24 GPIO_ACTIVE_HIGH>;
+		linux,axis = <REL_WHEEL>;
+		rotary-encoder,relative-axis;
+		rotary-encoder,steps-per-period = <2>;
+	};
+
+	/* Display and backlight: draft driver, enabled for stage-3 testing */
+	backlight: backlight {
+		compatible = "pwm-backlight";
+		pwms = <&pwm 0 30000 0>;
+		brightness-levels = <0 255>;
+		num-interpolated-steps = <255>;
+		default-brightness-level = <255>;	/* the bootloader's (full): no dip at hand-off */
+		pinctrl-names = "default";
+		pinctrl-0 = <&pins_pwm0>;
+		status = "okay";
+	};
+
+	display@13050000 {
+		compatible = "ingenic,x1000-slcd";
+		reg = <0x13050000 0x100>;
+		clocks = <&cgu X1000_CLK_LCD>;
+		clock-names = "lcd";
+		pinctrl-names = "default";
+		pinctrl-0 = <&pins_lcd>;
+		reset-gpios = <&gpb 13 GPIO_ACTIVE_HIGH>;	/* mipi_dbi: high = running */
+		cs-gpios = <&gpb 18 GPIO_ACTIVE_LOW>;		/* held as GPIOs, as Rockbox does */
+		rd-gpios = <&gpb 16 GPIO_ACTIVE_LOW>;
+		backlight = <&backlight>;
+		ingenic,panel = "gc9308";
+		status = "okay";
+	};
+
+	/*
+	 * Audio: X1000 I2S (clock provider, MCLK = 256 fs) -> ES9018K2M -> headphone
+	 * amplifier -> output switch -> headphone jack.
+	 * DAPM switches the amplifier and unmutes the switch only while playing.
+	 */
+	hp_amp_vcc: regulator-hp-amp {
+		compatible = "regulator-fixed";
+		regulator-name = "hp-amp";
+		gpios = <&gpb 6 GPIO_ACTIVE_HIGH>;		/* HPAMP_POWER */
+		enable-active-high;
+		startup-delay-us = <10000>;
+	};
+
+	hp_amp: audio-amplifier-hp {
+		compatible = "simple-audio-amplifier";
+		enable-gpios = <&gpb 8 GPIO_ACTIVE_HIGH>;	/* HPAMP_SHDN: 1 = play */
+		VCC-supply = <&hp_amp_vcc>;
+		sound-name-prefix = "HP Amp";
+	};
+
+	out_switch: audio-amplifier-switch {
+		compatible = "simple-audio-amplifier";
+		enable-gpios = <&gpb 15 GPIO_ACTIVE_LOW>;	/* STEREOSW_MUTE: 1 = muted */
+		sound-name-prefix = "Out Switch";
+	};
+
+	sound {
+		compatible = "simple-audio-card";
+		simple-audio-card,name = "H2";
+		simple-audio-card,format = "i2s";
+		simple-audio-card,bitclock-master = <&cpu_dai>;
+		simple-audio-card,frame-master = <&cpu_dai>;
+		simple-audio-card,mclk-fs = <256>;
+		simple-audio-card,aux-devs = <&hp_amp>, <&out_switch>;
+		simple-audio-card,widgets = "Headphone", "Headphones";
+		simple-audio-card,routing =
+			"HP Amp INL", "OUTL",
+			"HP Amp INR", "OUTR",
+			"Out Switch INL", "HP Amp OUTL",
+			"Out Switch INR", "HP Amp OUTR",
+			"Headphones", "Out Switch OUTL",
+			"Headphones", "Out Switch OUTR";
+		status = "okay";
+
+		cpu_dai: simple-audio-card,cpu {
+			sound-dai = <&aic>;
+			system-clock-direction-out;	/* the AIC drives MCLK to the DAC */
+		};
+
+		simple-audio-card,codec {
+			sound-dai = <&dac>;
+		};
+	};
+
+	/* microSD power switch; the bootloader already leaves it on */
+	vmmc: regulator-sd {
+		compatible = "regulator-fixed";
+		regulator-name = "sd-vcc";
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+		gpio = <&gpb 10 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		regulator-always-on;
+	};
+
+	/*
+	 * 5 V out on the USB-C port, for bus-powered USB DACs. dwc2 turns it on
+	 * only while it is the host (stock: USB_DRVVBUS, active high).
+	 */
+	usb_vbus: regulator-usb-vbus {
+		compatible = "regulator-fixed";
+		regulator-name = "usb-vbus";
+		regulator-min-microvolt = <5000000>;
+		regulator-max-microvolt = <5000000>;
+		gpio = <&gpb 25 GPIO_ACTIVE_HIGH>;	/* USB_DRVVBUS */
+		enable-active-high;
+	};
+
+	/* Bluetooth module power (stock BT_PWR), on only while Bluetooth is */
+	bt_vbat: regulator-bt {
+		compatible = "regulator-fixed";
+		regulator-name = "bt-vbat";
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+		gpio = <&gpc 22 GPIO_ACTIVE_HIGH>;	/* BT_PWR */
+		enable-active-high;
+		startup-delay-us = <10000>;
+	};
+};
+
+&exclk {
+	clock-frequency = <24000000>;
+};
+
+&tcu {
+	/*
+	 * The backlight is on PWM0 (PC25). By default the timer driver keeps TCU
+	 * channels 0 and 1 for itself, so hand channel 0 to PWM: PWM gets 0, 2, 3
+	 * and the timer uses 1 and 4.
+	 */
+	ingenic,pwm-channels-mask = <0x0d>;
+};
+
+&pwm {
+	status = "okay";
+};
+
+&ost {
+	/* 1500 kHz for the system timer and clocksource */
+	assigned-clocks = <&ost OST_CLK_EVENT_TIMER>, <&ost OST_CLK_GLOBAL_TIMER>;
+	assigned-clock-rates = <1500000>, <1500000>;
+};
+
+&msc0 {
+	status = "okay";
+
+	bus-width = <4>;
+	max-frequency = <50000000>;
+
+	pinctrl-names = "default";
+	pinctrl-0 = <&pins_msc0>;
+
+	cd-gpios = <&gpb 11 GPIO_ACTIVE_LOW>;
+	vmmc-supply = <&vmmc>;
+};
+
+&otg_phy {
+	status = "okay";
+};
+
+/*
+ * Both roles, chosen by the TCS1421 USB-C chip through the ID signal (the PHY
+ * reads it; no GPIO): device when a computer or charger is attached (console
+ * and network over the cable), host when a sink such as a USB DAC is, while
+ * the chip is in a dual-role mode.
+ */
+&otg {
+	status = "okay";
+	dr_mode = "otg";
+	vbus-supply = <&usb_vbus>;
+};
+
+/*
+ * The TCS1421's CFG1:CFG0 (PB30, PD5) are left to userspace (fathom-usbrole):
+ * 00 sink, 01 source, 10 strong DRP, 11 normal DRP. The bootloader leaves 00.
+ */
+
+/* Hardware RNG: seeds the kernel's random pool in about a second instead of ~40 s */
+&rng {
+	status = "okay";
+};
+
+/*
+ * Bluetooth: the BCM4343A1 core on UART0 with flow control (stock /dev/ttyS0).
+ * hci_bcm powers it (BT_PWR, then the RTC's 32 kHz sleep clock on PB26, then
+ * BT_REG_ON) only while Bluetooth is up, and loads the stock firmware patch
+ * from firmware_class.path. 1.5 Mbaud is the fastest the UART's 24 MHz clock
+ * gives exactly.
+ */
+&uart0 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&pins_uart0>;
+	uart-has-rtscts;
+	status = "okay";
+
+	bluetooth {
+		compatible = "brcm,bcm43438-bt";
+		max-speed = <1500000>;
+		shutdown-gpios = <&gpc 18 GPIO_ACTIVE_HIGH>;	/* BT_REG_ON */
+		vbat-supply = <&bt_vbat>;
+		clocks = <&rtc>;
+		clock-names = "lpo";
+	};
+};
+
+/*
+ * The RTC's 32.768 kHz output (clk32k) on PB26: the sleep clock (LPO) of the
+ * Bluetooth/Wi-Fi module, enabled by whichever of the two is on (hci_bcm, and
+ * Wi-Fi's mmc-pwrseq). The pin belongs to the clock's own node, so neither
+ * depends on the other's driver to have set it (patch 0015).
+ */
+&rtc {
+	#clock-cells = <0>;
+	pinctrl-names = "default";
+	pinctrl-0 = <&pins_rtc32k>;
+};
+
+/* AXP2101 PMIC: read-only battery monitor (draft, enabled for stage-3 testing) */
+&i2c2 {
+	clock-frequency = <400000>;
+	pinctrl-names = "default";
+	pinctrl-0 = <&pins_i2c2>;
+	status = "okay";
+
+	pmic@34 {
+		compatible = "x-powers,axp2101-battery-ro";
+		reg = <0x34>;
+	};
+};
+
+/* AIC: I2S master for the external DAC; MCLK from the fractional I2S PLL off SCLK_A */
+&aic {
+	pinctrl-names = "default";
+	pinctrl-0 = <&pins_i2s>;
+	ingenic,external-codec;
+	assigned-clocks = <&cgu X1000_CLK_I2SPLLMUX>, <&cgu X1000_CLK_I2S>;
+	assigned-clock-parents = <&cgu X1000_CLK_SCLKA>, <&cgu X1000_CLK_I2SPLL>;
+	status = "okay";
+};
+
+/*
+ * PB5 selects the output switch's destination: headphones (0) or line out (1).
+ * Left free for userspace: the player decides from the jack-detect switches
+ *.
+ */
+
+/* ES9018K2M DAC */
+&i2c1 {
+	clock-frequency = <400000>;
+	pinctrl-names = "default";
+	pinctrl-0 = <&pins_i2c1>;
+	status = "okay";
+
+	dac: dac@48 {
+		compatible = "ess,es9018k2m";
+		reg = <0x48>;
+		#sound-dai-cells = <0>;
+		power-gpios = <&gpb 12 GPIO_ACTIVE_HIGH>;
+		analog-power-gpios = <&gpb 9 GPIO_ACTIVE_HIGH>;
+	};
+};
+
+&pinctrl {
+	pins_lcd: lcd {
+		function = "lcd";
+		groups = "lcd-8bit";
+		bias-disable;
+	};
+
+	pins_pwm0: pwm0 {
+		function = "pwm0";
+		groups = "pwm0";
+		bias-disable;
+	};
+
+	pins_i2c1: i2c1 {
+		function = "i2c1";
+		groups = "i2c1-data-c";
+		bias-pull-up;
+	};
+
+	pins_i2c2: i2c2 {
+		function = "i2c2";
+		groups = "i2c2-data";
+		bias-pull-up;
+	};
+
+	pins_i2s: i2s {
+		function = "i2s";
+		groups = "i2s-data-tx", "i2s-clk-txrx", "i2s-sysclk";
+		bias-disable;
+	};
+
+	pins_rtc32k: rtc32k {
+		function = "rtc32k";
+		groups = "rtc32k";
+		bias-disable;
+	};
+
+	pins_uart0: uart0 {
+		function = "uart0";
+		groups = "uart0-data", "uart0-hwflow";
+		bias-disable;
+	};
+
+	pins_msc0: msc0 {
+		function = "mmc0";
+		groups = "mmc0-1bit", "mmc0-4bit";
+		bias-disable;
+	};
+};
diff -Naur a/arch/mips/ingenic/Kconfig b/arch/mips/ingenic/Kconfig
--- a/arch/mips/ingenic/Kconfig
+++ b/arch/mips/ingenic/Kconfig
@@ -39,6 +39,10 @@
 	bool "YSH & ATIL CU1000 Module with Neo backplane"
 	select MACH_X1000
 
+config X1000_HIFIWALKER_H2
+	bool "HiFi Walker H2 (AIGO Eros Q, hw4) digital audio player"
+	select MACH_X1000
+
 config X1830_CU1830_NEO
 	bool "YSH & ATIL CU1830 Module with Neo backplane"
 	select MACH_X1830
