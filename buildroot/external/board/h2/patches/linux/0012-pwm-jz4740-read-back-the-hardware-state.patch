From: Fathom <fathom@localhost>
Subject: [PATCH] pwm: jz4740: read back the hardware state

Without .get_state(), a PWM left running by the bootloader looks off, and
pwm-backlight (linked from a display node) then switches the backlight off
until the display driver enables it: on the HiFi Walker H2 the boot logo the
bootloader drew went dark for most of a second. Report enable, period, duty
and polarity from the TCU registers.
---
--- a/drivers/pwm/pwm-jz4740.c
+++ b/drivers/pwm/pwm-jz4740.c
@@ -213,10 +213,43 @@
 	return 0;
 }
 
+/*
+ * The state the hardware is in, so that a PWM left running by the bootloader
+ * (a backlight showing its boot logo) is seen as on: pwm-backlight then keeps
+ * the light on instead of switching it off until the panel driver starts.
+ */
+static int jz4740_pwm_get_state(struct pwm_chip *chip, struct pwm_device *pwm,
+				struct pwm_state *state)
+{
+	struct jz4740_pwm_chip *jz = to_jz4740(chip);
+	unsigned int ter, tcsr, period, duty;
+	unsigned long rate;
+
+	regmap_read(jz->map, TCU_REG_TER, &ter);
+	regmap_read(jz->map, TCU_REG_TCSRc(pwm->hwpwm), &tcsr);
+	state->enabled = (ter & BIT(pwm->hwpwm)) && (tcsr & TCU_TCSR_PWM_EN);
+	if (!state->enabled)
+		return 0;
+
+	rate = clk_get_rate(jz->clk[pwm->hwpwm]);
+	if (!rate) {
+		state->enabled = false;
+		return 0;
+	}
+	regmap_read(jz->map, TCU_REG_TDFRc(pwm->hwpwm), &period);
+	regmap_read(jz->map, TCU_REG_TDHRc(pwm->hwpwm), &duty);
+	state->period = DIV_ROUND_UP_ULL((u64)period * NSEC_PER_SEC, rate);
+	state->duty_cycle = DIV_ROUND_UP_ULL((u64)min(duty, period) * NSEC_PER_SEC, rate);
+	/* apply() sets INITL_HIGH for an enabled normal-polarity PWM */
+	state->polarity = (tcsr & TCU_TCSR_PWM_INITL_HIGH) ? PWM_POLARITY_NORMAL : PWM_POLARITY_INVERSED;
+	return 0;
+}
+
 static const struct pwm_ops jz4740_pwm_ops = {
 	.request = jz4740_pwm_request,
 	.free = jz4740_pwm_free,
 	.apply = jz4740_pwm_apply,
+	.get_state = jz4740_pwm_get_state,
 };
 
 static int jz4740_pwm_probe(struct platform_device *pdev)
