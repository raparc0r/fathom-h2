From: Fathom <fathom@localhost>
Subject: [PATCH] mtd: spinand: xtx: add XT26G01C

1 Gbit, 2048 + 128 byte pages, 64 pages per block, 8-bit on-die ECC per
512 bytes, quad enable bit (XTX datasheet "XT26G01C 3.3V 1G-BIT SPI NAND",
Rev A1.0). Found in the HiFi Walker H2 / AIGO Eros Q hw4.

Its ECC status is a 4-bit field in status bits 7:4 (ECCS3..0): 0 = no
errors, 1-8 = number of bits corrected, 0xf = uncorrectable (datasheet
table 8). Decoding it as the generic 2-bit field in bits 5:4 turns every
read with 2, 3, 6 or 7 corrected bits into an "uncorrectable" error and
reports 8 corrected bits as none; the H2's Rockbox bootloader has exactly
that bug.

Spare area per datasheet table 11: bytes 0-63 user data under ECC (byte 0
is the bad block marker), 64-115 ECC parity, 116-127 user data without ECC
(not offered as free space).

Signed-off-by: Fathom
---
diff -Naur a/drivers/mtd/nand/spi/xtx.c b/drivers/mtd/nand/spi/xtx.c
--- a/drivers/mtd/nand/spi/xtx.c
+++ b/drivers/mtd/nand/spi/xtx.c
@@ -16,6 +16,9 @@
 #define XT26G0XA_STATUS_ECC_8_CORRECTED	(3 << 4)
 #define XT26G0XA_STATUS_ECC_UNCOR_ERROR	(2 << 4)
 
+#define XT26G01C_STATUS_ECC_MASK	GENMASK(7, 4)
+#define XT26G01C_STATUS_ECC_UNCOR_ERROR	0xf
+
 #define XT26XXXD_STATUS_ECC3_ECC2_MASK	    GENMASK(7, 6)
 #define XT26XXXD_STATUS_ECC_NO_DETECTED     (0)
 #define XT26XXXD_STATUS_ECC_1_7_CORRECTED   (1)
@@ -91,6 +94,58 @@
 	return status >> 2;
 }
 
+/*
+ * XT26G01C spare area (datasheet table 11): bytes 0-63 user data protected by
+ * the on-die ECC (byte 0 is the bad block marker), 64-115 ECC parity, 116-127
+ * user data without ECC (not offered as free space).
+ */
+static int xt26g01c_ooblayout_ecc(struct mtd_info *mtd, int section,
+				  struct mtd_oob_region *region)
+{
+	if (section)
+		return -ERANGE;
+
+	region->offset = 64;
+	region->length = 52;
+
+	return 0;
+}
+
+static int xt26g01c_ooblayout_free(struct mtd_info *mtd, int section,
+				   struct mtd_oob_region *region)
+{
+	if (section)
+		return -ERANGE;
+
+	region->offset = 2;
+	region->length = 62;
+
+	return 0;
+}
+
+static const struct mtd_ooblayout_ops xt26g01c_ooblayout = {
+	.ecc = xt26g01c_ooblayout_ecc,
+	.free = xt26g01c_ooblayout_free,
+};
+
+/*
+ * ECCS3..0 in status bits 7:4: 0 = no errors, 1-8 = that many bits corrected,
+ * 0xf = uncorrectable. Unlike the generic layout, bit 5 alone does not mean
+ * "uncorrectable".
+ */
+static int xt26g01c_ecc_get_status(struct spinand_device *spinand,
+				   u8 status)
+{
+	u8 eccs = FIELD_GET(XT26G01C_STATUS_ECC_MASK, status);
+
+	if (eccs == XT26G01C_STATUS_ECC_UNCOR_ERROR)
+		return -EBADMSG;
+	if (eccs <= 8)
+		return eccs;
+
+	return -EINVAL;
+}
+
 static int xt26xxxd_ooblayout_ecc(struct mtd_info *mtd, int section,
 				  struct mtd_oob_region *region)
 {
@@ -169,6 +224,16 @@
 		     SPINAND_HAS_QE_BIT,
 		     SPINAND_ECCINFO(&xt26g0xa_ooblayout,
 				     xt26g0xa_ecc_get_status)),
+	SPINAND_INFO("XT26G01C",
+		     SPINAND_ID(SPINAND_READID_METHOD_OPCODE_ADDR, 0x11),
+		     NAND_MEMORG(1, 2048, 128, 64, 1024, 20, 1, 1, 1),
+		     NAND_ECCREQ(8, 512),
+		     SPINAND_INFO_OP_VARIANTS(&read_cache_variants,
+					      &write_cache_variants,
+					      &update_cache_variants),
+		     SPINAND_HAS_QE_BIT,
+		     SPINAND_ECCINFO(&xt26g01c_ooblayout,
+				     xt26g01c_ecc_get_status)),
 	SPINAND_INFO("XT26G01D",
 		     SPINAND_ID(SPINAND_READID_METHOD_OPCODE_ADDR, 0x31),
 		     NAND_MEMORG(1, 2048, 128, 64, 1024, 20, 1, 1, 1),
