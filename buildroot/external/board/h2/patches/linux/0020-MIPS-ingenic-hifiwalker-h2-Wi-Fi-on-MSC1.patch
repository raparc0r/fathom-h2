From: Fathom <fathom@localhost>
Subject: [PATCH] MIPS: ingenic: hifiwalker-h2: Wi-Fi (BCM43438) on MSC1

--- a/arch/mips/boot/dts/ingenic/hifiwalker-h2.dts	2026-11-16 23:32:14
+++ b/arch/mips/boot/dts/ingenic/hifiwalker-h2.dts	2026-11-17 00:11:27
@@ -248,6 +248,21 @@
 		gpio = <&gpc 22 GPIO_ACTIVE_HIGH>;	/* BT_PWR */
 		enable-active-high;
 		startup-delay-us = <10000>;
+	};
+
+	/*
+	 * Wi-Fi: WL_REG_ON is PC17 (the stock kernel's "wifi_reset", next to
+	 * BT_REG_ON on PC18), held low until MSC1 is ready, with the module's
+	 * 32 kHz sleep clock. The module's supply (BT_PWR) is shared with
+	 * Bluetooth; fathom-wifi unbinds MSC1 while Wi-Fi is off, so the supply
+	 * follows "Wi-Fi or Bluetooth wanted".
+	 */
+	wifi_pwrseq: wifi-pwrseq {
+		compatible = "mmc-pwrseq-simple";
+		reset-gpios = <&gpc 17 GPIO_ACTIVE_LOW>;	/* WL_REG_ON */
+		clocks = <&rtc>;
+		clock-names = "ext_clock";
+		post-power-on-delay-ms = <200>;
 	};
 };
 
@@ -285,6 +300,21 @@
 
 	cd-gpios = <&gpb 11 GPIO_ACTIVE_LOW>;
 	vmmc-supply = <&vmmc>;
+};
+
+/* Wi-Fi: the BCM43438 on SDIO, the X1000's second MMC controller (PC00-PC05) */
+&msc1 {
+	status = "okay";
+
+	bus-width = <4>;
+	max-frequency = <25000000>;
+	non-removable;
+
+	pinctrl-names = "default";
+	pinctrl-0 = <&pins_msc1>;
+
+	vmmc-supply = <&bt_vbat>;
+	mmc-pwrseq = <&wifi_pwrseq>;
 };
 
 &otg_phy {
@@ -436,4 +466,10 @@
 		groups = "mmc0-1bit", "mmc0-4bit";
 		bias-disable;
 	};
+
+	pins_msc1: msc1 {
+		function = "mmc1";
+		groups = "mmc1-1bit", "mmc1-4bit";
+		bias-pull-up;
+	};
 };
