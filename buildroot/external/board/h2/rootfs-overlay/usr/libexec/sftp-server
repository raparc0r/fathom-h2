#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# SFTP for SSH logins (dropbear runs this): the Green End SFTP server, from the
# card with the network drive's programs (post-build.sh).
S=/mnt/sd/fathom/share
export LD_LIBRARY_PATH=$S/usr/lib:$S/lib:/mnt/sd/fathom/wifi/usr/lib:/mnt/sd/fathom/wifi/lib:/mnt/sd/fathom/bt/usr/lib:/mnt/sd/fathom/bt/lib
exec $S/usr/libexec/gesftpserver "$@"
