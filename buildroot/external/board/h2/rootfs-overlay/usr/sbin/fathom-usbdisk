#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
#
# USB drive mode: lend the microSD card to the computer until it's ejected
# there or the cable is unplugged, then mount it again. S90fathom runs this when
# the player exits for it (exit code 42), so nothing has the card open.
# Leaves /tmp/fathom-rescan for the player (new music), or a message in
# /tmp/fathom-usbdisk.msg if the card couldn't be lent. If the card comes
# back unusable (formatted as exFAT, fathom/ deleted), the player can't run:
# the card-out screen until a card is put in (card_wait), not a player
# started every 2 s from a card that hasn't one.

. /usr/lib/fathom/card.sh               # (card_disk, card_mount, card_wait, ...)
LUN=/sys/kernel/config/usb_gadget/fathom/functions/mass_storage.0/lun.0
# (the card mounted: after it's been out and back it may be another mmcblk)
DEV=$(awk '$2 == "/mnt/sd" { print $1; exit }' /proc/mounts)
DEV=${DEV:-/dev/mmcblk0p1}
udc=$(ls /sys/class/udc | head -n 1)
STATE=/sys/class/udc/$udc/state
MSG=/tmp/fathom-usbdisk.msg

say() { echo "usbdisk: $1"; }

[ -d $LUN ] || { say "no USB drive function"; echo "USB drive mode isn't available" > $MSG; exit 1; }
[ "$(cat $STATE 2>/dev/null)" = configured ] || { say "not connected"; exit 0; }

sync
fathom-bt stop > /dev/null 2>&1   # Bluetooth runs from the card
fathom-share off > /dev/null 2>&1 # the network drive (it has the card open)
fathom-wifi off > /dev/null 2>&1  # so does Wi-Fi
if ! umount /mnt/sd 2>/dev/null; then
    say "card busy:"; fuser -m /mnt/sd 2>&1
    echo "The card is in use: try again" > $MSG
    exit 1
fi
if ! echo $DEV > $LUN/file; then
    say "cannot lend $DEV"
    card_mount "$(card_disk)" > /dev/null
    echo "Couldn't start USB drive mode" > $MSG
    exit 1
fi
say "card lent to the computer"

# Nothing else runs now (the player has exited, Bluetooth and Wi-Fi are off):
# let the computer's writes gather in RAM and reach the card in big pieces,
# instead of the 1 MB at most that keeps memory free for music (sysctl.d).
VM=/proc/sys/vm
dbg=$(cat $VM/dirty_background_bytes) dlim=$(cat $VM/dirty_bytes)
echo 2097152 > $VM/dirty_background_bytes
echo 8388608 > $VM/dirty_bytes

# Until it's ejected (the file goes empty) or the cable stays unplugged for 3 s.
# A computer resets the USB link when the drive appears (macOS does), and the
# link is "suspended" while it sleeps: neither ends drive mode.
gone=0
while [ -n "$(cat $LUN/file)" ]; do
    if [ "$(cat $STATE 2>/dev/null)" = "not attached" ]; then gone=$((gone + 1)); else gone=0; fi
    [ $gone -ge 3 ] && break
    sleep 1
done
echo 1 > $LUN/forced_eject 2>/dev/null
sync
echo $dlim > $VM/dirty_bytes
echo $dbg > $VM/dirty_background_bytes
say "card back ($(cat $STATE 2>/dev/null))"

# (the computer may have partitioned it afresh: the card's disk, as at boot)
dev=
for i in 1 2 3; do
    dev=$(card_mount "$(card_disk)") && break
    sleep 1
done
if [ -z "$dev" ]; then
    say "the card can't be mounted (not FAT?): waiting for a card"
    card_wait
elif ! card_has_fathom; then
    say "the card is back ($dev), but without Fathom: waiting for a card"
    card_wait
else
    touch /tmp/fathom-rescan
fi
