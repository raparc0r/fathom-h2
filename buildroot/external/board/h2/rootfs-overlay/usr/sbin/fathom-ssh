#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
#
# SSH (Settings > SSH): dropbear on port 22, over the USB link and Wi-Fi, for
# root with a password, and SFTP (/usr/libexec/sftp-server).
#   echo PASSWORD | fathom-ssh on    root's password is PASSWORD; SSH started
#   echo PASSWORD | fathom-ssh off   root's password is PASSWORD; SSH stopped
#   fathom-ssh boot                  as the settings say (S90fathom, before the player)
#   fathom-ssh status                on or off
#
# The build locks root (no password works) until one is set here, so neither
# SSH nor the USB serial console lets anyone in before. The host key is kept
# on the card (fathom/keys), so computers know the H2 again after a restart;
# so is authorized_keys, if you put one there: public keys that may log in
# without the password.
#
# dropbear is kept on the card (fathom/ssh), out of the RAM disk; while SSH is
# on it runs from a copy in RAM, so logins stay quick when memory is short and
# USB drive mode can still lend the card. It runs at nice 10, and so does
# everything started from a login (SFTP included): audio comes first.

K=/mnt/sd/fathom/keys
DB=/mnt/sd/fathom/ssh/dropbearmulti
RUN=/var/run/fathom-ssh
SETTINGS=/mnt/sd/fathom/settings.ini
PID=/var/run/dropbear.pid

say() { echo "ssh: $1" >&2; }
alive() { [ -f $PID ] && kill -0 "$(cat $PID)" 2>/dev/null; }
setting() { sed -n "s/^[[:space:]]*$1[[:space:]]*=[[:space:]]*//p" $SETTINGS 2>/dev/null | tail -1 | tr -d '\r' | sed 's/[[:space:]]*$//'; }

password() {
    [ -n "$1" ] || { say "no password"; return 2; }
    printf 'root:%s\n' "$1" | chpasswd > /dev/null 2>&1 || { say "couldn't set the password"; return 1; }
}

start() {
    alive && return 0
    [ -x $DB ] || { say "dropbear isn't on the card ($DB)"; return 1; }
    mkdir -p $K $RUN
    if [ ! -s $K/ssh_host_ed25519_key ]; then
        rm -f $K/ssh_host_ed25519_key
        $DB dropbearkey -t ed25519 -f $K/ssh_host_ed25519_key > /dev/null 2>&1 || { say "couldn't make a host key"; return 1; }
    fi
    mkdir -p /root/.ssh
    chmod 700 /root /root/.ssh
    if [ -s $K/authorized_keys ]; then
        cp $K/authorized_keys /root/.ssh/authorized_keys && chmod 600 /root/.ssh/authorized_keys
    else
        rm -f /root/.ssh/authorized_keys
    fi
    # (by a new name, then renamed: sessions may still run the last copy; run
    # by its full path, each login starts it afresh, as dropbear prefers)
    cp $DB $RUN/dropbear.new && chmod 755 $RUN/dropbear.new && mv $RUN/dropbear.new $RUN/dropbear ||
        { say "couldn't copy dropbear to RAM"; return 1; }
    # -W: a 512 KB receive window (dropbear's default is 24 KB): copying to
    # the H2 over Wi-Fi waited on round trips at 1.1 MB/s; now 1.9 MB/s (and
    # 2.8 to 3.6 MB/s over USB). A session stays about 1.1 MB: the card keeps up.
    # The host key from RAM too: dropbear reads it again for each login, and
    # in USB drive mode the card is lent to the computer (logins were refused).
    (umask 077; cp $K/ssh_host_ed25519_key $RUN/host_key) || { say "couldn't copy the host key"; return 1; }
    # Nothing on the card held open into dropbear: it outlives the player and
    # stays through USB drive mode, and one file on the card left open in it
    # (once, a track the player had open, handed down) kept the card busy, so
    # it couldn't be lent to the computer. Only the card's: the shell reads
    # this script (in RAM) on a descriptor of its own.
    for fd in /proc/$$/fd/*; do
        case "$(readlink "$fd")" in /mnt/sd/*) n=${fd##*/}; eval "exec $n<&-" ;; esac
    done
    nice -n 10 $RUN/dropbear -r $RUN/host_key -p 22 -P $PID -W 524288
    for i in $(seq 1 20); do alive && break; sleep 0.1; done
    alive || { say "dropbear didn't start"; return 1; }
}

stop() {
    alive && kill "$(cat $PID)"
    rm -f $PID $RUN/dropbear $RUN/host_key   # (its RAM goes once the last session ends)
    return 0
}

case "$1" in
on|off)
    read -r pass
    password "$pass" || exit $?
    if [ "$1" = on ]; then start || exit 1; else stop; fi
    echo "$1"
    ;;
boot)
    pass=$(setting ssh.password)
    [ -n "$pass" ] || exit 0          # (the player makes one up)
    password "$pass" || exit $?
    [ "$(setting ssh.on)" = 1 ] && start
    exit 0
    ;;
status)
    alive && echo on || echo off
    ;;
*)
    echo "usage: echo PASSWORD | fathom-ssh on|off, or fathom-ssh boot|status" >&2
    exit 2
    ;;
esac
