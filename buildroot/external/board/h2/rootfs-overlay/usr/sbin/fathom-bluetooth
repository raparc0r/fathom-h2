#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# Additional terms under GPLv3 section 7: see LICENSE.
#
# The Bluetooth chip (BCM4343A1 on UART0, kernel driver hci_uart_bcm):
#   fathom-bluetooth on       power it up and load its firmware patch: hci0
#   fathom-bluetooth off      power it down (the default: it draws current while on)
#   fathom-bluetooth status
#
# The kernel binds the driver at boot, before the card is mounted, so the chip
# starts without its firmware patch; "on" binds it again once the patch can be
# read from the card (firmware_class.path=/mnt/sd/fathom/firmware). The patch
# is the stock firmware's, copied there by the user: Fathom doesn't ship it.

DRV=/sys/bus/serial/drivers/hci_uart_bcm
DEV=serial0-0
FW=/mnt/sd/fathom/firmware/brcm/BCM43430A1.hcd
HCI=/sys/class/bluetooth/hci0
HCIWAIT=100                             # hci0 is given this many tenths of a second to appear

say() { echo "bluetooth: $1"; }

case "$1" in
on)
    # (start-up's "off" still under way, S35bluetooth: 3 s at most)
    i=0
    while [ -d /var/run/fathom-bluetooth.off ] && [ $i -lt 30 ]; do sleep 0.1; i=$((i + 1)); done
    [ -d $DRV ] || { say "no driver"; exit 1; }
    [ -f $FW ] || say "no firmware patch at $FW: starting without it"
    [ -e $DRV/$DEV ] && echo $DEV > $DRV/unbind
    echo $DEV > $DRV/bind || { say "cannot start"; exit 1; }
    # hci0 looked for every tenth of a second, for 10 s (it was once a second:
    # most of a second lost at every start)
    i=0
    while [ $i -lt $HCIWAIT ]; do
        [ -e $HCI ] && break
        sleep 0.1
        i=$((i + 1))
    done
    [ -e $HCI ] || { say "no hci0"; exit 1; }
    # No wait here for the firmware patch (it was a fixed 2 s). hci0 is there
    # as soon as the driver registers it; the kernel then loads the patch
    # (about 1 s) and only tells BlueZ of the controller once that's done
    # (while a controller is being set up it's on no list bluetoothd can ask
    # for, and "index added" comes after: net/bluetooth/mgmt.c, hci_core.c).
    # fathom-bt start waits for exactly that, the controller in bluetoothctl's
    # "show", so D-Bus and bluetoothd start while the patch loads.
    say "on (hci0)"
    ;;
off)
    [ -e $DRV/$DEV ] && echo $DEV > $DRV/unbind
    say "off"
    ;;
status)
    [ -e $HCI ] && echo on || echo off
    ;;
*)
    echo "usage: $0 on|off|status" >&2
    exit 2
    ;;
esac
