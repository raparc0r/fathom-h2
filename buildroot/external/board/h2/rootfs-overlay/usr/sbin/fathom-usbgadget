#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
#
# What the H2 is to a computer, switched by the player:
#   fathom-usbgadget dac      a USB DAC: a USB Audio Class 2 input (stereo,
#                             44.1 to 192 kHz, 32-bit samples) and media keys
#   fathom-usbgadget normal   back to serial, network and USB drive
#
# The audio input is the only thing the computer sends to in DAC mode. Everything the computer sends goes
# through one receive FIFO in the H2's USB controller, and stopping the audio
# stream (the computer does it on every pause) needs that FIFO to drain:
# with network packets waiting in it, dwc2 gives up stopping the endpoint
# and carries on, and later transfers come out garbled (a corrupt network
# packet panicked the kernel). The computer sees the device disconnect and
# come back as a different one.
#
# The audio arrives on ALSA card "UAC2Gadget"; its "Capture Rate" control is
# the rate the computer is sending, 0 while it sends nothing. The player
# copies it to the DAC as it comes (USB DAC mode).

G=/sys/kernel/config/usb_gadget/fathom
C=$G/configs/c.1
A=$G/functions/uac2.0
K=$G/functions/hid.keys

say() { echo "usbgadget: $1"; }

[ -d $G ] || { say "no gadget"; exit 1; }
udc=$(ls /sys/class/udc | head -n 1)

unbind() { echo "" > $G/UDC 2>/dev/null; }
bind() { echo "$udc" > $G/UDC; }
link_normal() {
    for f in acm.GS0 ecm.usb0 mass_storage.0; do
        [ -L $C/$f ] || ln -s $G/functions/$f $C/
    done
}
# Back to serial, network and USB drive, bound; a second try after a moment
# (the controller may still be letting go of the last configuration)
normal() {
    unbind
    rm -f $C/uac2.0 $C/hid.keys
    link_normal
    echo "Serial, network and USB drive" > $C/strings/0x409/configuration
    bind 2>/dev/null || { sleep 1; bind; }
}

case "$1" in
dac)
    [ -L $C/uac2.0 ] && exit 0
    unbind
    rm -f $C/mass_storage.0 $C/acm.GS0 $C/ecm.usb0
    if [ ! -d $A ]; then
        mkdir $A || { normal; say "no USB audio function"; exit 1; }
        echo 0 > $A/p_chmask                  # nothing from the H2 to the computer
        echo 3 > $A/c_chmask                  # stereo from the computer
        echo 44100,48000,88200,96000,176400,192000 > $A/c_srate
        echo 4 > $A/c_ssize                   # 32-bit samples: 24-bit audio is exact
        echo async > $A/c_sync                # the H2's clock leads (feedback)
        echo 3 > $A/c_hs_bint                 # a packet every 0.5 ms (every 125 us is too
        echo 8 > $A/req_number                #   much for the X1000), 8 queued; 192 kHz fits
        echo 0 > $A/c_mute_present 2>/dev/null   # volume is the H2's own
        echo 0 > $A/c_volume_present 2>/dev/null
        echo 0 > $A/p_mute_present 2>/dev/null
        echo 0 > $A/p_volume_present 2>/dev/null
        echo "Fathom H2" > $A/function_name 2>/dev/null
    fi
    ln -s $A $C/
    # Media keys: the H2's Play, Prev and Next for the computer's player. A
    # HID consumer control with no OUT endpoint: it only ever sends, so
    # nothing of it goes through the receive FIFO the audio needs to itself.
    if [ -d $K ] || mkdir $K 2>/dev/null; then
        if [ ! -s $K/report_desc ] || [ "$(cat $K/report_length)" != 1 ]; then
            echo 0 > $K/protocol
            echo 0 > $K/subclass
            echo 1 > $K/report_length
            echo 1 > $K/no_out_endpoint
            # Consumer Control: Play/Pause, Next, Previous (1 bit each), 5 bits padding
            printf '\005\014\011\001\241\001\025\000\045\001\165\001\225\003\011\315\011\265\011\266\201\002\225\005\201\001\300' > $K/report_desc
        fi
        ln -s $K $C/
    fi
    echo "USB DAC" > $C/strings/0x409/configuration
    # Refused (the controller can't take the audio function as it is): the
    # computer gets its serial, network and drive back rather than nothing
    # until a restart, and the player says USB DAC mode isn't available
    if ! bind; then
        say "cannot bind the USB DAC: back to normal"
        normal || say "cannot bind"
        exit 1
    fi
    say "USB DAC"
    ;;
normal)
    [ -L $C/mass_storage.0 ] && [ -n "$(cat $G/UDC 2>/dev/null)" ] && exit 0   # (linked, and bound)
    normal || { say "cannot bind"; exit 1; }
    say "USB drive"
    ;;
*)
    echo "usage: $0 dac|normal" >&2
    exit 2
    ;;
esac
