#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# The microSD card taken out and put back while the H2 runs: busybox's uevent
# listens to the kernel's uevents (asleep until one comes: no polling) and
# runs fathom-sdcard for each, which stops Fathom when the card goes and
# starts it again when it's back. After S01bootlog's mount, before the player.
case "$1" in
start)
    start-stop-daemon -S -b -m -p /var/run/sdcard.pid -x /sbin/uevent -- /usr/libexec/fathom-sdcard
    /usr/libexec/fathom-sdcard check    # no card at start-up: the screen says so
    ;;
stop)
    start-stop-daemon -K -q -p /var/run/sdcard.pid
    rm -f /var/run/sdcard.pid
    ;;
esac
