#
# Bluetooth is the player's to start (Settings > Bluetooth, through fathom-bt):
# at boot the chip stays powered down; at shutdown the stack stops, which also
# saves the pairings to the card.

case "$1" in
start)
    # Beside the scripts that follow (the chip's driver takes 0.2 s to let go
    # of it, all waiting). A mark while it's under way: fathom-bluetooth on
    # waits for it to go, so this "off" can't land on a start asked for after.
    mkdir /var/run/fathom-bluetooth.off 2>/dev/null
    ( fathom-bluetooth off > /dev/null 2>&1; rmdir /var/run/fathom-bluetooth.off 2>/dev/null ) &
    ;;
stop)
    fathom-bt stop > /dev/null 2>&1
    ;;
esac
