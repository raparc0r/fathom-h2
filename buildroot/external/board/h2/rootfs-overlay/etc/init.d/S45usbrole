# USB-C port role: sink for computers and chargers, dual role to find USB DACs.
# (it logs to syslog itself: no shell or logger kept running for it)
case "$1" in
    start) start-stop-daemon -S -b -m -p /var/run/usbrole.pid -x /usr/sbin/fathom-usbrole ;;
    stop)  killall fathom-usbrole 2>/dev/null ;;
esac
