#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# Additional terms under GPLv3 section 7: see LICENSE.
#
# What the H2 is to a computer (a configfs gadget, one configuration):
#   acm.GS0         serial console, ttyGS0
#   ecm.usb0        network: the H2 is 10.42.0.1 (S40usbnet); fixed MACs, so the
#                   computer keeps one interface
#   mass_storage.0  a USB drive with no medium: USB drive mode lends it the
#                   microSD card (fathom-usbdisk)

G=/sys/kernel/config/usb_gadget/fathom

case "$1" in
start)
    # (As few programs started as will do: one mkdir for every folder, one ln
    # for the three functions, the rest the shell's own. Fourteen were started
    # here, an eighth of a second of every start.)
    [ -d /sys/kernel/config/usb_gadget ] || mount -t configfs none /sys/kernel/config
    [ -d $G ] && exit 0
    mkdir $G $G/strings/0x409 $G/configs/c.1 $G/configs/c.1/strings/0x409 \
          $G/functions/acm.GS0 $G/functions/ecm.usb0 $G/functions/mass_storage.0 && cd $G || exit 1
    echo 0x1d6b > idVendor          # Linux Foundation
    echo 0x0104 > idProduct         # multifunction composite gadget
    echo 0x0100 > bcdDevice
    echo 0x0200 > bcdUSB
    echo 0xef > bDeviceClass        # composite with interface associations
    echo 0x02 > bDeviceSubClass
    echo 0x01 > bDeviceProtocol
    echo "Fathom" > strings/0x409/manufacturer
    echo "Fathom" > strings/0x409/product
    echo "fathom-h2" > strings/0x409/serialnumber

    echo "Serial, network and USB drive" > configs/c.1/strings/0x409/configuration
    echo 500 > configs/c.1/MaxPower

    echo 02:46:41:54:48:01 > functions/ecm.usb0/dev_addr
    echo 02:46:41:54:48:02 > functions/ecm.usb0/host_addr
    L=functions/mass_storage.0/lun.0
    echo 1 > $L/removable
    echo 0 > $L/ro
    echo "Fathom  microSD" > $L/inquiry_string

    ln -s $G/functions/acm.GS0 $G/functions/ecm.usb0 $G/functions/mass_storage.0 configs/c.1/
    # (the controller is set up beside the kernel's other drivers,
    # driver_async_probe: almost always long done; 3 s for it at most)
    i=0
    while [ $i -lt 60 ]; do
        for u in /sys/class/udc/*; do
            [ -e "$u" ] && { echo "${u##*/}" > UDC; break 2; }
        done
        sleep 0.05
        i=$((i + 1))
    done
    ;;
esac
