# SPDX-License-Identifier: GPL-2.0-or-later
# Fathom H2 kernel options, applied on top of mainline's cu1000-neo_defconfig.

# Board
# CONFIG_X1000_CU1000_NEO is not set
CONFIG_X1000_HIFIWALKER_H2=y

# 32 MiB RAM: no highmem, no CMA, smaller everything
# CONFIG_HIGHMEM is not set
# Contiguous buffers (display dumb buffer, later audio DMA) must still be found
# after hours of file I/O: compaction plus a small CMA pool (usable by movable
# pages until a driver needs it).
CONFIG_COMPACTION=y
CONFIG_CMA=y
CONFIG_DMA_CMA=y
CONFIG_CMA_SIZE_MBYTES=2

CONFIG_PRINTK_TIME=y
CONFIG_PANIC_TIMEOUT=10

# Hardware the H2 doesn't have (Wi-Fi: modules, below)
# CONFIG_STMMAC_ETH is not set
# CONFIG_SERIAL_SC16IS7XX is not set
# CONFIG_SPI is not set
# CONFIG_SENSORS_ADS7828 is not set
# CONFIG_SCSI is not set

# Blue LED heartbeat, microSD, FAT
CONFIG_LEDS_TRIGGERS=y
CONFIG_LEDS_TRIGGER_HEARTBEAT=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
CONFIG_MMC=y
CONFIG_MMC_JZ4740=y
CONFIG_VFAT_FS=y
CONFIG_FAT_DEFAULT_IOCHARSET="iso8859-1"
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y
CONFIG_TMPFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
# No debugfs (it was for bring-up: clocks, GPIO): its 1,200 files took 420 KiB
# of kernel memory that never goes back. 2026-11-18.
# CONFIG_DEBUG_FS is not set
CONFIG_BLK_DEV_INITRD=y

# Size: a music player on 32 MiB doesn't need these (mainline's reference board does)
# CONFIG_CGROUPS is not set
# CONFIG_NAMESPACES is not set
# CONFIG_IO_URING is not set
# CONFIG_KALLSYMS_ALL is not set
# CONFIG_IKCONFIG is not set
# CONFIG_SWAP is not set
# CONFIG_IPV6 is not set
# CONFIG_ETHERNET is not set
# CONFIG_EXT4_FS is not set
# CONFIG_NETWORK_FILESYSTEMS is not set
# CONFIG_SLUB_DEBUG is not set
# CONFIG_COREDUMP is not set

# USB: dwc2 + X1000 PHY in both roles. Device (default): a configfs gadget
# (S30usbgadget) = serial (ACM) + network (ECM) + a USB drive with no medium,
# which the card is lent to in USB drive mode (fathom-usbdisk); in USB DAC mode
# a USB Audio Class 2 input takes the drive's place (fathom-usbgadget). Host: USB DACs
# through snd-usb-audio. The role is switched from userspace (/sys/class/usb_role),
# with VBUS from a regulator.
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_GADGET=y
CONFIG_USB_DWC2=y
CONFIG_USB_DWC2_DUAL_ROLE=y
CONFIG_USB_ROLE_SWITCH=y
CONFIG_SND_USB=y
CONFIG_SND_USB_AUDIO=y
CONFIG_PHY_INGENIC_USB=y
# CONFIG_USB_CDC_COMPOSITE is not set
CONFIG_CONFIGFS_FS=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_MASS_STORAGE=y
# USB drive mode: 8 buffers of 16 KB instead of 2, so receiving from the
# computer and writing to the card overlap rather than take turns.
CONFIG_USB_GADGET_STORAGE_NUM_BUFFERS=8
CONFIG_USB_CONFIGFS_F_UAC2=y
CONFIG_USB_CONFIGFS_F_HID=y
CONFIG_U_SERIAL_CONSOLE=y

# Display (draft driver, device-tree node disabled until tested): X1000 smart LCD,
# MIPI-DBI panel, PWM backlight on TCU channel 0. Built in so it's compile-checked.
CONFIG_DRM=y
# No fbdev emulation: nothing uses /dev/fb0 (the player and the card-out
# screen draw through DRM), and it reserved a 150 KB framebuffer for fbcon.
# CONFIG_DRM_FBDEV_EMULATION is not set
CONFIG_TINYDRM_X1000_SLCD=y
CONFIG_PWM=y
CONFIG_PWM_JZ4740=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_PWM=y

# Power and audio
CONFIG_I2C=y
CONFIG_I2C_JZ4780=y
CONFIG_POWER_SUPPLY=y
CONFIG_BATTERY_AXP2101_RO=y
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_SND_JZ4740_SOC_I2S=y
CONFIG_SND_SOC_ES9018K2M=y
CONFIG_SND_SIMPLE_CARD=y
CONFIG_SND_SOC_SIMPLE_AMPLIFIER=y
CONFIG_DMA_JZ4780=y

# No virtual terminals or text console on the screen (about 400 KB of kernel
# with fbdev emulation): kernel messages go to the USB serial console and
# pstore, and the screen showed only the boot logo, which h2boot has already
# drawn: the panel keeps it (patch 0013) until the player's first frame.
# CONFIG_VT is not set
# CONFIG_FRAMEBUFFER_CONSOLE is not set

# Hardware RNG (X1000), so the random pool is ready for SSH and the player at boot
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_INGENIC_RNG=y

# Buttons (gpio-keys), scroll wheel (rotary-encoder), read by the player through evdev
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_GPIO=y
CONFIG_INPUT_MISC=y
# BlueZ turns the Bluetooth headphones' buttons (AVRCP) into a uinput keyboard
CONFIG_INPUT_UINPUT=y
CONFIG_INPUT_GPIO_ROTARY_ENCODER=y

# pstore/ramoops: kernel log and oops records survive a reset (bring-up debugging)
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
# No pmsg (userspace's records): nothing writes to it, and the DT gives it no room
# CONFIG_PSTORE_PMSG is not set
# Plain-text records: a record that partly decays over a power cut stays readable
# CONFIG_PSTORE_COMPRESS is not set

# Hangs become panics (pstore keeps the log; panic=10 reboots): a CPU stuck in the
# kernel for 20 s, or a task blocked for 120 s. The hardware watchdog (S05watchdog)
# resets the H2 if even that can't run, e.g. an interrupt storm.
CONFIG_SOFTLOCKUP_DETECTOR=y
CONFIG_BOOTPARAM_SOFTLOCKUP_PANIC=y
CONFIG_DETECT_HUNG_TASK=y
CONFIG_BOOTPARAM_HUNG_TASK_PANIC=y
# No kernel boot logo (fbcon drew it): h2boot's stays on the panel
# CONFIG_LOGO is not set

# Bluetooth: the BCM4343A1 on UART0 (hci_bcm, a serdev driver). Its firmware
# patch is the stock one, never shipped with Fathom: fathom-bluetooth copies
# it from the stock firmware onto the card, and the kernel loads it from there
# (firmware_class.path on the command line).
CONFIG_SERIAL_DEV_BUS=y
CONFIG_SERIAL_DEV_CTRL_TTYPORT=y
CONFIG_BT=y
CONFIG_BT_BREDR=y
CONFIG_BT_LE=y
CONFIG_BT_HCIUART=y
CONFIG_BT_HCIUART_SERDEV=y
CONFIG_BT_HCIUART_H4=y
CONFIG_BT_HCIUART_BCM=y
CONFIG_BT_BCM=y

# Wi-Fi: the BCM43438 on SDIO (MSC1). cfg80211 and brcmfmac are modules, kept
# on the card (fathom/wifi/modules) and loaded only while Wi-Fi is on: unloading
# them when it goes off gives back about 600 KB.
CONFIG_MODULE_UNLOAD=y
CONFIG_WIRELESS=y
CONFIG_CFG80211=m
CONFIG_WLAN=y
CONFIG_WLAN_VENDOR_BROADCOM=y
CONFIG_BRCMUTIL=m
CONFIG_BRCMFMAC=m
CONFIG_BRCMFMAC_SDIO=y

# ---- Memory: the H2 has 32 MiB and the kernel's code and data never come back ----
# (Measured 2026-11-17: 6.4 MiB of kernel code; everything here was unused.)
# No symbol table: oopses print addresses (System.map from the build names them).
# CONFIG_KALLSYMS is not set
# The kernel log buffer: 64 KiB (pstore keeps its own copy).
CONFIG_LOG_BUF_SHIFT=16
# The card's FAT needs 437, ISO 8859-1 and UTF-8 only.
# CONFIG_NLS_CODEPAGE_936 is not set
# CONFIG_NLS_CODEPAGE_950 is not set
# CONFIG_NLS_ASCII is not set
# The initramfs is gzip: no other decompressors.
# CONFIG_RD_BZIP2 is not set
# CONFIG_RD_LZMA is not set
# CONFIG_RD_XZ is not set
# CONFIG_RD_LZO is not set
# CONFIG_RD_LZ4 is not set
# CONFIG_RD_ZSTD is not set
# No Ethernet: no USB network adapters, PHYs or ethtool netlink.
# CONFIG_USB_NET_DRIVERS is not set
# CONFIG_PHYLIB is not set
# CONFIG_ETHTOOL_NETLINK is not set
# No BPF, no Bluetooth debugfs.
# CONFIG_BPF_SYSCALL is not set
# CONFIG_BT_DEBUGFS is not set
# Crypto nobody uses (Bluetooth needs AES, CMAC, SHA-256, ECDH; Wi-Fi's regdb RSA).
# CONFIG_CRYPTO_KRB5 is not set
# CONFIG_CRYPTO_KRB5ENC is not set
# CONFIG_CRYPTO_CAMELLIA is not set
# CONFIG_CRYPTO_SHA3 is not set
# CONFIG_CRYPTO_CTS is not set
# CONFIG_CRYPTO_DEFLATE is not set
# Page reclaim: the multi-generational LRU (CONFIG_LRU_GEN) was tried on
# 2026-11-18 and left out: playback with network-drive downloads running,
# with and without 1.5 MB less memory, gave no underruns and no measurable
# difference in page faults either way, and it costs 16 KB.

# No helper program run for every kernel event: the base config names
# /sbin/hotplug, which isn't in the system, so each event (several hundred
# while starting, and more at every Wi-Fi or Bluetooth start) forked a thread
# that failed to run it. The card's and the radios' events are read from the
# netlink socket (busybox uevent in S10sdcard), which this doesn't touch.
# CONFIG_UEVENT_HELPER is not set
