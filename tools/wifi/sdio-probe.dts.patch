--- a/arch/mips/boot/dts/ingenic/hifiwalker-h2.dts	2026-11-16 23:32:14
+++ b/arch/mips/boot/dts/ingenic/hifiwalker-h2.dts	2026-11-16 23:32:15
@@ -249,6 +249,19 @@
 		enable-active-high;
 		startup-delay-us = <10000>;
 	};
+
+	/*
+	 * Wi-Fi test (is the module's Wi-Fi half wired?): the stock kernel drives
+	 * GPIO 81 (PC17, "wifi_reset") high next to BT_REG_ON (PC18): WL_REG_ON,
+	 * held low until MSC1 is ready, with the module's 32 kHz sleep clock.
+	 */
+	wifi_pwrseq: wifi-pwrseq {
+		compatible = "mmc-pwrseq-simple";
+		reset-gpios = <&gpc 17 GPIO_ACTIVE_LOW>;	/* WL_REG_ON */
+		clocks = <&rtc>;
+		clock-names = "ext_clock";
+		post-power-on-delay-ms = <200>;
+	};
 };
 
 &exclk {
@@ -285,6 +298,21 @@
 
 	cd-gpios = <&gpb 11 GPIO_ACTIVE_LOW>;
 	vmmc-supply = <&vmmc>;
+};
+
+/* Wi-Fi test: the X1000's second MMC controller on its pins PC00-PC05 (SDIO) */
+&msc1 {
+	status = "okay";
+
+	bus-width = <4>;
+	max-frequency = <25000000>;
+	non-removable;
+
+	pinctrl-names = "default";
+	pinctrl-0 = <&pins_msc1>;
+
+	vmmc-supply = <&bt_vbat>;
+	mmc-pwrseq = <&wifi_pwrseq>;
 };
 
 &otg_phy {
@@ -436,4 +464,10 @@
 		groups = "mmc0-1bit", "mmc0-4bit";
 		bias-disable;
 	};
+
+	pins_msc1: msc1 {
+		function = "mmc1";
+		groups = "mmc1-1bit", "mmc1-4bit";
+		bias-pull-up;
+	};
 };
